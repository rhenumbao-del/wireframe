<body>

  <!-- Part 1: Card container -->
  <article class="card">

    <!-- Part 2: Cover div with background image from URL and fixed height -->
    <div class="cover"></div>

    <div class="card-body">
      <!-- Part 3: Photo (img tag from URL with alt text) -->
      <img 
        src=
      >

      <!-- Part 4: Name and subtitle -->
      <h2>Rhynier Umbao</h2>
      <p class="subtitle">ACT STUDENT &amp; TAMBAY</p>

      <!-- Part 5: Description (two or three sentences about the subject) -->
      <p class="description">
        Passionate digital designer creating intuitive user experiences and playful vector illustrations. Based in Seattle, she collaborates with global tech startups to bring creative brand stories to life.
      </p>

      <!-- Part 6: Details (a list of three facts, skills, or favorites) -->
      <ul>
        <li><strong>Figma &amp; Design Systems</strong> &mdash; 5+ years building accessible component libraries</li>
        <li><strong>Brand Identity</strong> &mdash; Crafted visual styles for over 20 digital products</li>
        <li><strong>Coffee &amp; Ceramic Arts</strong> &mdash; Weekend potter and pour-over enthusiast</li>
      </ul>
    </div>

  </article>

</body>
